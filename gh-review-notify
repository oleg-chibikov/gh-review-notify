#!/bin/bash
# macOS notification for every review and comment someone else leaves on a pull
# request you authored, take part in, or were asked to review.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export GH_PAGER=cat

days=${GH_REVIEW_NOTIFY_DAYS:-3}
bots=${GH_REVIEW_NOTIFY_BOTS:-0}
state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gh-review-notify"
state="$state_dir/seen.txt"

notify() { # title, subtitle, message, url
  if command -v terminal-notifier > /dev/null; then
    terminal-notifier -title "$1" -subtitle "$2" -message "$3" -open "$4" -group "$4" -sound Glass > /dev/null 2>&1
  else
    osascript -e "display notification \"${3//\"/ }\" with title \"${1//\"/ }\" subtitle \"${2//\"/ }\"" > /dev/null 2>&1
  fi
}

badge() { # event kind
  case "$1" in
    approved) echo "✅ Approved" ;;
    changes) echo "⛔️ Changes requested" ;;
    request) echo "👀 Review requested" ;;
    review) echo "📝 Review" ;;
    *) echo "💬 Comment" ;;
  esac
}

clock() { # ISO 8601 UTC
  local epoch
  epoch=$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2> /dev/null) || return 0
  if [ "$(date -r "$epoch" +%F)" = "$(date +%F)" ]; then
    date -r "$epoch" +%H:%M
  else
    date -r "$epoch" '+%b %-d, %H:%M'
  fi
}

byline() { # who, PR author, ISO 8601 UTC
  local whose time
  case "$2" in
    "") whose="" ;;
    "$me") whose="your PR" ;;
    *) whose="$2's PR" ;;
  esac
  time=$(clock "$3")
  printf '%s%s%s' "$1" "${whose:+ · $whose}" "${time:+ · $time}"
}

if [ "${1:-}" = "--test" ]; then
  notify "gh-review-notify" "$(date +%H:%M)" "Notifications are working" "https://github.com/notifications"
  echo "Sent a test notification. Nothing on screen means macOS is blocking it:"
  echo "System Settings > Notifications > terminal-notifier > Allow notifications."
  exit 0
fi

if [ "${1:-}" = "--status" ]; then
  agent=$(launchctl list 2> /dev/null | awk '$3 == "io.github.gh-review-notify" { print "running, last exit code " $2 }')
  echo "agent:    ${agent:-not loaded, run install.sh}"
  echo "account:  $(gh api user --jq .login 2> /dev/null || echo 'gh is not logged in')"
  echo "last run: $(stat -f %Sm "$state_dir/pr-updated.tsv" 2> /dev/null || echo never)"
  echo "seen:     $( (wc -l < "$state" 2> /dev/null || echo 0) | tr -d ' ') events, looking $days days back, bots=$bots"
  echo "log:      $HOME/Library/Logs/gh-review-notify.log"
  exit 0
fi

command -v gh > /dev/null || { echo "gh is not installed" >&2; exit 1; }
command -v jq > /dev/null || { echo "jq is not installed" >&2; exit 1; }

mkdir -p "$state_dir"
first_run=0
if [ ! -f "$state" ]; then
  first_run=1
  : > "$state"
fi

# One run at a time, so a manual run and the agent can't report the same comment.
lock="$state_dir/lock"
find "$lock" -maxdepth 0 -mmin +15 -exec rmdir {} \; 2> /dev/null
mkdir "$lock" 2> /dev/null || exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$lock"' EXIT
events="$tmp/events.tsv"
: > "$events"

cache_updated="$state_dir/pr-updated.tsv"
cache_requests="$state_dir/review-requests.tsv"
touch "$cache_updated" "$cache_requests"

lookup() { # file, url, column
  awk -F'\t' -v u="$2" -v c="$3" '$1 == u { print $c; exit }' "$1"
}

me=$(gh api user --jq .login) || { echo "gh is not logged in: run gh auth login" >&2; exit 1; }
since=$(date -u -v-"${days}"d +%Y-%m-%dT%H:%M:%SZ)
day=$(date -u -v-"${days}"d +%Y-%m-%d)

search_prs() {
  gh search prs "$@" --state open --updated ">=$day" --limit 100 --json url,title,updatedAt,author
}

requested_from_me() {
  local path=${1#https://github.com/}
  gh api "repos/${path%/pull/*}/pulls/${path##*/}" --jq '.requested_reviewers[].login' 2> /dev/null |
    grep -qxF "$me"
}

{
  search_prs --author @me
  search_prs --involves @me
  search_prs --reviewed-by @me
} 2> /dev/null |
  jq -rs 'add | unique_by(.url) | .[] | [.url, .title, .updatedAt, .author.login] | @tsv' > "$tmp/base.tsv"

# review-requested also matches a request sent to a team you belong to, so every
# hit is checked for your own name on the PR. The answer is kept until the pull
# request changes again.
gh search prs --review-requested @me --state open --limit 100 --json url,title,author,updatedAt --jq \
  '.[] | [.url, .title, .author.login, .updatedAt] | @tsv' > "$tmp/requested.tsv" 2> /dev/null

: > "$tmp/personal.tsv"
: > "$tmp/requests.tsv"
while IFS=$'\t' read -r url title author updated; do
  verdict=""
  [ "$(lookup "$cache_requests" "$url" 2)" = "$updated" ] && verdict=$(lookup "$cache_requests" "$url" 3)
  if [ -z "$verdict" ]; then
    if requested_from_me "$url"; then verdict=personal; else verdict=team; fi
  fi
  printf '%s\t%s\t%s\n' "$url" "$updated" "$verdict" >> "$tmp/requests.tsv"
  [ "$verdict" = "personal" ] || continue
  printf '%s\t%s\t%s\t%s\n' "$url" "$title" "$updated" "$author" >> "$tmp/personal.tsv"
  path=${url#https://github.com/}
  repo=${path%/pull/*}
  printf '%s#review-requested\trequest\t%s\t%s\t%s\t%s\t%s\n' \
    "$url" "$updated" "$author" "${repo#*/}#${path##*/}" "$author" "$title" >> "$events"
done < "$tmp/requested.tsv"
mv "$tmp/requests.tsv" "$cache_requests"

sort -t$'\t' -k1,1 -u "$tmp/base.tsv" "$tmp/personal.tsv" > "$tmp/prs.tsv"

: > "$tmp/updated.tsv"
while IFS=$'\t' read -r url title updated owner; do
  # Nothing happened on this pull request since the last look.
  if [ "$(lookup "$cache_updated" "$url" 2)" = "$updated" ]; then
    printf '%s\t%s\n' "$url" "$updated" >> "$tmp/updated.tsv"
    continue
  fi

  path=${url#https://github.com/}
  repo=${path%/pull/*}
  num=${path##*/}
  pr="${repo#*/}#$num"

  ok=1
  gh api "repos/$repo/pulls/$num/reviews" > "$tmp/reviews.json" 2> /dev/null || ok=0
  gh api "repos/$repo/issues/$num/comments?since=$since&per_page=100" > "$tmp/issue.json" 2> /dev/null || ok=0
  gh api "repos/$repo/pulls/$num/comments?since=$since&per_page=100" > "$tmp/inline.json" 2> /dev/null || ok=0

  # An empty COMMENTED review is only the wrapper around inline comments, which
  # are reported one by one below.
  {
    jq -r --arg me "$me" --arg since "$since" --arg pr "$pr" --arg t "$title" --arg bots "$bots" --arg owner "$owner" '
      .[]
      | select(.user.login != $me and .submitted_at > $since)
      | select($bots == "1" or .user.type != "Bot")
      | select(.state != "COMMENTED" or (.body // "") != "")
      | [ .html_url,
          (if .state == "APPROVED" then "approved"
           elif .state == "CHANGES_REQUESTED" then "changes"
           else "review" end),
          .submitted_at,
          .user.login,
          $pr,
          $owner,
          (if (.body // "") == "" then $t else .body[0:150] end) ]
      | @tsv' "$tmp/reviews.json" 2> /dev/null

    # Comments on the conversation tab.
    jq -r --arg me "$me" --arg pr "$pr" --arg bots "$bots" --arg owner "$owner" '
      .[]
      | select(.user.login != $me)
      | select($bots == "1" or .user.type != "Bot")
      | [.html_url, "comment", .created_at, .user.login, $pr, $owner, .body[0:150]]
      | @tsv' "$tmp/issue.json" 2> /dev/null

    # Inline comments on the diff.
    jq -r --arg me "$me" --arg pr "$pr" --arg bots "$bots" --arg owner "$owner" '
      .[]
      | select(.user.login != $me)
      | select($bots == "1" or .user.type != "Bot")
      | [.html_url, "comment", .created_at, .user.login, $pr, $owner, (.path // "") + ": " + .body[0:120]]
      | @tsv' "$tmp/inline.json" 2> /dev/null
  } >> "$events"

  # A failed call means the comments are still unread, so the PR is left out of
  # the cache and looked at again next time.
  [ "$ok" = 1 ] && printf '%s\t%s\n' "$url" "$updated" >> "$tmp/updated.tsv"
done < "$tmp/prs.tsv"
mv "$tmp/updated.tsv" "$cache_updated"

: > "$tmp/new.tsv"
while IFS=$'\t' read -r key kind when actor pr owner message; do
  [ -z "${key:-}" ] && continue
  grep -qxF "$key" "$state" && continue
  printf '%s\n' "$key" >> "$state"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$key" "$kind" "$when" "$actor" "$pr" "$owner" "$message" >> "$tmp/new.tsv"
done < "$events"

if [ "$first_run" = 0 ]; then
  # An approval or a change request always arrives on its own, so it can't get
  # lost inside a pile of comments.
  awk -F'\t' '$2 != "comment"' "$tmp/new.tsv" > "$tmp/single.tsv"
  awk -F'\t' '$2 == "comment"' "$tmp/new.tsv" > "$tmp/comments.tsv"

  while IFS=$'\t' read -r key kind when actor pr owner message; do
    notify "$(badge "$kind") · $pr" "$(byline "$actor" "$owner" "$when")" \
      "${message//\\n/ }" "${key%#review-requested}"
  done < "$tmp/single.tsv"

  # A reviewer who leaves ten inline comments in one go gets one notification.
  awk -F'\t' '{ split($1, a, "#"); print a[1] }' "$tmp/comments.tsv" | sort | uniq -c |
    while read -r count url; do
      rows="$tmp/rows.tsv"
      awk -F'\t' -v u="$url#" 'index($1, u) == 1' "$tmp/comments.tsv" > "$rows"
      if [ "$count" -gt 4 ]; then
        last=$(sort -t$'\t' -k3,3 "$rows" | tail -1)
        who=$(cut -f4 "$rows" | sort -u | paste -sd "," - | sed 's/,/, /g')
        notify "💬 $count new comments · $(cut -f5 <<< "$last")" \
          "$(byline "$who" "$(cut -f6 <<< "$last")" "$(cut -f3 <<< "$last")")" \
          "$(cut -f7 <<< "$last")" "$url"
      else
        while IFS=$'\t' read -r key kind when actor pr owner message; do
          notify "$(badge "$kind") · $pr" "$(byline "$actor" "$owner" "$when")" \
            "${message//\\n/ }" "$key"
        done < "$rows"
      fi
    done
fi

tail -n 3000 "$state" > "$state.trim" && mv "$state.trim" "$state"

[ "$first_run" = 1 ] && echo "Seeded $(wc -l < "$state" | tr -d ' ') past events. Only new ones will pop up."
exit 0
